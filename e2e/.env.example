# ─── ErpLite E2E configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# App under test (Angular dev server). Leave the default to let Playwright
# auto-start `npm start` for you. Point at a deployed URL to test that instead.
BASE_URL=http://localhost:4200

# Backend API base. The running local API uses a self-signed cert — that is
# tolerated automatically (ignoreHTTPSErrors).
API_URL=https://localhost:7089/api

# ── Test account credentials ────────────────────────────────────────────────
# REQUIRED for the authenticated smoke suite and all deep module specs.
# Use a dedicated test account on a test tenant, ideally with broad permissions
# so permission-gated pages are exercised rather than skipped.
TEST_USERNAME=
TEST_PASSWORD=

# UI language used for text assertions: `en` (default, most stable) or `ar`.
TEST_LANG=en

# Persist login as a long-lived token (recommended: true).
REMEMBER_ME=true

# ── Write safety switch ─────────────────────────────────────────────────────
# When false (default), specs that CREATE / EDIT / POST / DELETE real records
# are skipped, so a run is safe and read-only. Set to true to exercise the full
# write/business flows against the backend. Only enable against a TEST tenant.
ALLOW_WRITES=false

# Auto-start the Angular dev server (`npm start`) if BASE_URL is local.
# Set false if you start `ng serve` yourself or test a deployed environment.
E2E_START_WEBSERVER=true

# ── Optional timeout tuning (milliseconds) ──────────────────────────────────
# E2E_EXPECT_TIMEOUT=15000
# E2E_ACTION_TIMEOUT=15000
# E2E_NAV_TIMEOUT=45000
